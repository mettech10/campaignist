# Copy to .env for local dev. .env is gitignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key — bypasses RLS. Backend only, never ship to the browser.
SUPABASE_SERVICE_KEY=
# Only set this if the project still uses legacy HS256 JWTs. Leave blank to
# verify via the JWKS endpoint (asymmetric keys, current Supabase default).
SUPABASE_JWT_SECRET=

# ── Models ──────────────────────────────────────────────────────────────────
# The pipeline asks for a *role*; these decide the model, and the model decides
# the provider. The two roles can sit on different providers — that is what
# makes a bake-off an env change rather than a code change.
#
# Both MUST enforce a strict JSON Schema; the pipeline has no JSON-repair path.
# See the MODELS table in api/app/pipeline/llm.py for what is allowed.
#
#   kimi-k3            $3.00/$15.00 per MTok    kimi  (always-on thinking: ~4 min/call)
#   kimi-k2.6          $0.95/$4.00              kimi
#   kimi-k2.5          $0.60/$3.00              kimi   REJECTED — see below
#   claude-sonnet-5    $3.00/$15.00             anthropic
#   claude-haiku-4-5   $1.00/$5.00              anthropic
MODEL_STRATEGY=kimi-k2.6
# Not kimi-k2.5. It is cheaper and it ignores response_format often enough to
# lose most of a campaign's creative assets — resolve_role refuses it outright.
MODEL_CONTENT=kimi-k2.6

# OpenAI-compatible providers only; Anthropic's models reject sampling params.
LLM_TEMPERATURE=0.6
# Every pipeline call is schema-constrained extraction, so thinking earns
# nothing and would skew a bake-off on latency and output tokens.
ANTHROPIC_THINKING=disabled

# ── Provider credentials — set the ones your roles actually use ─────────────
# Kimi key from platform.moonshot.ai (the account needs a small top-up before a
# key authenticates). MOONSHOT_API_KEY is accepted as an alias.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Only needed if a role is pointed at a claude-* model.
ANTHROPIC_API_KEY=
# Optional: any other OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ── App ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
# Comma-separated. Vercel mints a NEW hostname for every deployment, so pinning
# a deployment URL breaks on the next deploy — use the stable production alias.
# A wrong value shows up in the browser as "Failed to fetch" and leaves no trace
# in the server logs, because the request is never sent.
CORS_ORIGINS=https://campaignist.vercel.app,http://localhost:3000

# ── GPU render worker ───────────────────────────────────────────────────────
# Shared secret for the rented GPU box that renders video. You invent this
# value: `openssl rand -hex 32`. The same string goes on the worker as
# WORKER_TOKEN. Deliberately not the service-role key — the worker runs on a
# marketplace machine you do not own, so losing it should cost GPU time and
# nothing else. Unset means the worker endpoints refuse rather than open.
RENDER_WORKER_TOKEN=
